# Canonical local environment file for Wardline.
# Use this file (or .env.local) at the repo root for local development.

# Runtime ports
PORT=3001
# Voice Runtime V2 (default 3003). Do not reuse PORT; that is for Nest core-api.
# VOICE_RUNTIME_V2_PORT=3003
NODE_ENV=development
# ENVIRONMENT=production
# Structured logs: omit or "pretty" for dev console; "json" for one JSON object per line (core-api pino, voice structlog).
# WARDLINE_LOG_FORMAT=json
# LOG_LEVEL=info
# OpenTelemetry OTLP (HTTP/protobuf). Unset to disable trace export. Use distinct service names per process.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=wardline-core-api
# OTEL_SDK_DISABLED=false

# Shared local services
DATABASE_URL="postgresql://wardline:wardline_dev@localhost:5432/wardline?schema=public"
REDIS_URL="redis://localhost:6379"
WEB_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_BASE_URL="http://localhost:3000"
CORE_API_BASE_URL="http://localhost:3001"
# URI prefix the voice runtime prepends to Core API paths (must match Nest versioning, default /v1).
CORE_API_PATH_PREFIX="/v1"
# For the first real Twilio call proof, set this to the same public tunnel URL as VOICE_RUNTIME_V2_PUBLIC_URL.
WEBHOOK_BASE_URL=""
# Web client
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_CORE_API_URL="http://localhost:3001"
# Public base URL for Voice Runtime V2 (browser may call /health, etc.). Legacy: NEXT_PUBLIC_VOICE_ORCHESTRATOR_URL.
NEXT_PUBLIC_VOICE_RUNTIME_URL="http://localhost:3003"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Clerk server/webhooks
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Twilio
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+15555550123"
# Public URL Twilio POSTs to (scheme + host, no path). Must match the webhook URL in Twilio for signature validation.
TWILIO_WEBHOOK_PUBLIC_URL=""
# Local/ngrok only: skip Twilio X-Twilio-Signature checks (never enable in production).
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# Shared secret for voice/runtime → core-api @Public routes (header X-Wardline-Internal-Secret). Required in production.
WARDLINE_INTERNAL_API_SECRET=""
# 32-byte key as base64, or a long passphrase (scrypt-derived). Encrypts integration + select BusinessSettings secrets at rest.
WARDLINE_APP_CREDENTIALS_KEY=""

# LLM (Voice Runtime V2 uses Deepgram for STT/TTS; Azure Speech is not used.)
# With LLM_PROVIDER=auto (default), OpenAI is used when OPENAI_API_KEY is set; otherwise Azure OpenAI when configured.
# When keys are set, the runtime uses an LLM for routing (supervisor), optional semantic safety triage, and slot hints.
# Set to false to force rule-only behavior. VOICE_LLM_TIMEOUT_SECONDS caps each LLM request.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
LLM_PROVIDER="auto"
VOICE_LLM_SUPERVISOR=true
VOICE_LLM_SAFETY=true
# Slot LLM: routing hints from the supervisor plus a second pass (Phase 2) before rule-based specialists fill slots.
VOICE_LLM_SLOTS=true
# LLM specialist agents: full multi-agent mode where each domain gets a context-rich LLM call with caller history.
# Falls back to rule-based specialists when disabled or when the LLM response is low-confidence.
VOICE_LLM_AGENTS=true
VOICE_LLM_TIMEOUT_SECONDS=12
AZURE_OPENAI_KEY="your_azure_openai_key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"

# Voice Runtime V2 provider stack
VOICE_RUNTIME_V2_PORT="3003"
# For the first real Twilio call proof, set this to the same public tunnel URL as WEBHOOK_BASE_URL.
VOICE_RUNTIME_V2_PUBLIC_URL=""
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_TOKEN_TTL_MINUTES="60"
DEEPGRAM_API_KEY=""
DEEPGRAM_STT_MODEL="nova-2-phonecall"
DEEPGRAM_TTS_MODEL="aura-2-thalia-en"
# Endpointing: ms of silence before Deepgram marks speech as final. Higher = waits longer for caller to finish.
# 300 (old default) cuts callers off mid-sentence; 1200 gives natural pause tolerance.
DEEPGRAM_ENDPOINTING_MS=1200
# Utterance end: ms after last speech to emit an UtteranceEnd event. Acts as a second-layer flush signal.
DEEPGRAM_UTTERANCE_END_MS=1500
MANAGED_TTS_PROVIDER="deepgram"
# Twilio media websocket URL is derived from the public callback URL plus this path.
TWILIO_MEDIA_STREAM_PATH="/telephony/twilio/media"
# Voice session store: set REDIS_URL (above) so voice-runtime-v2 can share sessions across instances and survive restarts.
# VOICE_SESSION_TTL_SECONDS=14400
# VOICE_SESSION_MAX_CACHED=5000
# VOICE_SESSION_LOCK_BLOCKING_SECONDS=15
# VOICE_SHUTDOWN_DRAIN_SECONDS=30
# VOICE_DEEPGRAM_RECONNECT_ATTEMPTS=8
# VOICE_HTTP_MAX_RETRIES=3

# Optional vendor / billing keys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
TIMETAP_API_KEY=""
TIMETAP_BASE_URL="https://api.timetap.com"

# Mock integration smoke flow
MOCK_INTEGRATION_BASE_URL="http://127.0.0.1:4010"
MOCK_INTEGRATION_PORT="4010"
MOCK_INTEGRATION_TIMEOUT_MS="5000"
MOCK_ATHENAHEALTH_TOKEN="mock-athena-token"
MOCK_CREDENTIALS_REF="MOCK_ATHENAHEALTH_TOKEN"
SMOKE_BUSINESS_NAME="Smoke Family Medicine"
SMOKE_BUSINESS_SLUG="smoke-family-medicine"
SMOKE_PHONE_NUMBER="+15551230001"
SMOKE_TWILIO_SID="PN_SMOKE_0001"
SMOKE_CLERK_USER_ID="user_smoke_owner"
SMOKE_USER_EMAIL="smoke.owner@wardline.local"
SMOKE_USER_NAME="Smoke Owner"

# Staging validation seed
STAGING_BUSINESS_NAME="Wardline Family Medicine Staging"
STAGING_BUSINESS_SLUG="wardline-family-medicine-staging"
STAGING_PHONE_NUMBER="+15551239999"
STAGING_TWILIO_SID="PN_STAGING_0001"
STAGING_CLERK_USER_ID="user_staging_owner"
STAGING_USER_EMAIL="staging.owner@wardline.local"
STAGING_USER_NAME="Staging Owner"
# Integration seed + health checks: use the mock server (`pnpm mock:integrations`, leave running).
# Base URL uses the success scenario; switch path prefix to /scenario/timeout|unsupported|error for fallback tests.
STAGING_INTEGRATION_BASE_URL="http://127.0.0.1:4010/scenario/success"
STAGING_CONNECTOR_TIMEOUT_MS="3500"
STAGING_PRACTICE_ID="family-medicine-staging"
STAGING_DEPARTMENT_ID="primary-care"
# Must match MOCK_ATHENAHEALTH_TOKEN / mock server; use real ATHENAHEALTH_* secret refs only for live Athena staging.
STAGING_SCHEDULING_CREDENTIALS_REF="MOCK_ATHENAHEALTH_TOKEN"
STAGING_EHR_REFILL_CREDENTIALS_REF="MOCK_ATHENAHEALTH_TOKEN"
STAGING_INSURANCE_CREDENTIALS_REF="MOCK_ATHENAHEALTH_TOKEN"
STAGING_BILLING_CREDENTIALS_REF="MOCK_ATHENAHEALTH_TOKEN"
