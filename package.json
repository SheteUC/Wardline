{
  "name": "wardline",
  "version": "1.0.0",
  "private": true,
  "description": "HIPAA-compliant business-native AI voice receptionist platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "test": "turbo run test",
    "test:e2e:web": "pnpm --filter @wardline/web test:e2e",
    "mock:integrations": "node scripts/mock-integration-server.js",
    "voice:v2:dev": "node scripts/run-voice-v2-python.js apps/voice-runtime-v2/server.py",
    "voice:v2:preflight": "node scripts/run-voice-v2-python.js apps/voice-runtime-v2/preflight.py",
    "voice:v2:proof": "node scripts/voice-v2-proof.js",
    "test:voice:v2": "node scripts/run-voice-v2-python.js -m unittest discover apps/voice-runtime-v2/tests -v",
    "check:business-terminology": "node scripts/check-business-terminology.js",
    "test:smoke:typecheck": "pnpm exec tsc --noEmit -p apps/core-api/tsconfig.json && pnpm exec tsc --noEmit -p apps/web/tsconfig.json && pnpm check:business-terminology",
    "test:smoke:api": "pnpm --filter @wardline/db build && pnpm --filter @wardline/db test && pnpm --filter @wardline/core-api test -- --runInBand auth/auth.guard.spec.ts auth/rbac.guard.spec.ts audit/audit.service.spec.ts cache/cache.service.spec.ts health.controller.spec.ts modules/businesses/businesses.service.spec.ts modules/calls/calls.service.spec.ts modules/follow-up-tasks/follow-up-tasks.service.spec.ts modules/integrations/integration-connectors.service.spec.ts modules/runtime-actions/runtime-actions.service.spec.ts modules/workflows/workflows.service.spec.ts tasks/transcript-retention.task.spec.ts",
    "test:smoke:web": "pnpm --filter @wardline/web test -- --runInBand",
    "test:smoke:voice": "pnpm test:voice:v2",
    "test:smoke:db": "pnpm --filter @wardline/db migrate:deploy && pnpm --filter @wardline/db check:audit-log-immutability",
    "test:smoke": "pnpm test:smoke:typecheck && pnpm test:smoke:api && pnpm test:smoke:web && pnpm test:smoke:voice",
    "test:smoke:local": "pnpm test:smoke",
    "test:staging:env": "node scripts/check-staging-env.js",
    "test:staging:preflight": "pnpm test:smoke && pnpm test:staging:env",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @wardline/db generate",
    "db:migrate": "pnpm --filter @wardline/db migrate:dev",
    "db:studio": "pnpm --filter @wardline/db studio",
    "db:seed": "pnpm --filter @wardline/db seed",
    "db:seed:smoke": "pnpm --filter @wardline/db seed:smoke",
    "db:seed:staging": "pnpm --filter @wardline/db seed:staging",
    "db:seed:test": "pnpm --filter @wardline/db seed:test",
    "db:backfill:call-events": "pnpm --filter @wardline/db backfill:call-events",
    "db:verify:call-projections": "pnpm --filter @wardline/db verify:call-projections"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.10.6",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "prettier": "^3.1.1",
    "turbo": "^1.11.3",
    "typescript-eslint": "^8.46.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.12",
      "effect": "3.21.0",
      "hono": "4.12.10",
      "js-yaml": "4.1.1",
      "lodash": "4.18.1",
      "multer": "2.1.1",
      "next": "16.2.2",
      "file-type": "21.3.2",
      "path-to-regexp": "0.1.13",
      "preact": "10.29.0",
      "qs": "6.14.2",
      "socket.io-parser": "4.2.6"
    }
  },
  "dependencies": {
    "axios": "^1.14.0",
    "dotenv": "^17.2.3"
  }
}
