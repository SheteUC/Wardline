// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Tenant & Organization Models
// ============================================================================

model Business {
  id        String         @id @default(uuid())
  name      String         @unique
  slug      String         @unique
  timeZone  String         @default("America/New_York") @map("time_zone")
  status    BusinessStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  settings               BusinessSettings?
  integrations          BusinessIntegration[]
  users                  BusinessUser[]
  phoneNumbers           PhoneNumber[]
  callers                Caller[]
  callSessions           CallSession[]
  workflows              Workflow[]
  auditLogs              AuditLog[]
  subscriptions          StripeSubscription[]
  usageRecords           UsageRecord[]
  schedulingIntegrations SchedulingIntegration[]
  appointments           Appointment[]
  agents                 Agent[]
  voicemails             VoicemailRecord[]
  followUpTasks          FollowUpTask[]
  prescriptionRefills    PrescriptionRefill[]
  insurancePlans         InsurancePlan[]
  insuranceInquiries     InsuranceInquiry[]
  insuranceVerifications InsuranceVerification[]

  @@index([slug])
  @@map("businesses")
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
}

model BusinessSettings {
  id                      String           @id @default(uuid())
  businessId              String           @unique @map("business_id")
  recordingDefault        RecordingDefault @default(ON) @map("recording_default")
  transcriptRetentionDays Int              @default(30) @map("transcript_retention_days")
  operatingHours          Json?            @map("operating_hours")
  enabledActions          String[]         @default([]) @map("enabled_actions")
  afterHoursPolicy        Json?            @map("after_hours_policy")
  refillPolicy            Json?            @map("refill_policy")
  billingPolicy           Json?            @map("billing_policy")
  insurancePolicy         Json?            @map("insurance_policy")
  knowledgeConfig         Json?            @map("knowledge_config")
  escalationConfig        Json?            @map("escalation_config")
  /** Override list of out-of-scope keywords that trigger deflection */
  outOfScopeKeywords      String[]         @map("out_of_scope_keywords")
  /** Additional emergency keywords on top of system defaults */
  emergencyKeywords       String[]         @map("emergency_keywords")
  timetapBaseUrl          String?          @map("timetap_base_url")
  timetapApiKey           String?          @map("timetap_api_key")
  nexhealthBaseUrl        String?          @map("nexhealth_base_url")
  nexhealthApiKey         String?          @map("nexhealth_api_key")
  stripeCustomerId        String?          @map("stripe_customer_id")
  posthogProjectApiKey    String?          @map("posthog_project_api_key")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

enum RecordingDefault {
  ON
  OFF
  ASK
}

model BusinessIntegration {
  id                String                    @id @default(uuid())
  businessId        String                    @map("business_id")
  category          IntegrationCategory
  vendor            String
  status            IntegrationStatus         @default(DISCONNECTED)
  credentialsRef    String?                   @map("credentials_ref")
  settings          Json?
  capabilities      Json?
  lastHealthCheckAt DateTime?                 @map("last_health_check_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, category])
  @@index([businessId, status])
  @@map("business_integrations")
}

enum IntegrationCategory {
  SCHEDULING
  EHR_REFILL
  BILLING
  INSURANCE
  KNOWLEDGE
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// ============================================================================
// User & RBAC Models
// ============================================================================

model User {
  id          String   @id @default(uuid())
  clerkUserId String   @unique @map("clerk_user_id")
  email       String
  fullName    String?  @map("full_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  businesses               BusinessUser[]
  createdWorkflowVersions  WorkflowVersion[] @relation("CreatedVersions")
  approvedWorkflowVersions WorkflowVersion[] @relation("ApprovedVersions")

  @@index([clerkUserId])
  @@map("users")
}

model BusinessUser {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  role       UserRole
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
  @@map("business_users")
}

enum UserRole {
  OWNER
  ADMIN
  SUPERVISOR
  AGENT
  READONLY
}

// ============================================================================
// Phone Numbers & Configuration
// ============================================================================

model PhoneNumber {
  id                String   @id @default(uuid())
  businessId        String   @map("business_id")
  twilioPhoneNumber String   @unique @map("twilio_phone_number")
  twilioSid         String   @unique @map("twilio_sid")
  workflowId        String?  @map("workflow_id")
  label             String
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workflow     Workflow?     @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  callSessions CallSession[]

  @@index([businessId])
  @@index([twilioSid])
  @@map("phone_numbers")
}

// ============================================================================
// Workflows
// ============================================================================

model Workflow {
  id          String         @id @default(uuid())
  businessId  String         @map("business_id")
  name        String
  description String
  status      WorkflowStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  versions     WorkflowVersion[]
  phoneNumbers PhoneNumber[]

  @@index([businessId])
  @@map("workflows")
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model WorkflowVersion {
  id               String                @id @default(uuid())
  workflowId       String                @map("workflow_id")
  versionNumber    Int                   @map("version_number")
  graphJson        Json                  @map("graph_json")
  createdByUserId  String                @map("created_by_user_id")
  approvedByUserId String?               @map("approved_by_user_id")
  status           WorkflowVersionStatus @default(DRAFT)
  publishedAt      DateTime?             @map("published_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  createdBy  User     @relation("CreatedVersions", fields: [createdByUserId], references: [id])
  approvedBy User?    @relation("ApprovedVersions", fields: [approvedByUserId], references: [id])

  @@unique([workflowId, versionNumber])
  @@index([workflowId])
  @@map("workflow_versions")
}

enum WorkflowVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
}

// ============================================================================
// Callers (lightweight identity — not full patient record)
// ============================================================================

model Caller {
  id           String    @id @default(uuid())
  businessId   String    @map("business_id")
  name         String?
  phone        String
  dob          DateTime? @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  callSessions        CallSession[]
  prescriptionRefills PrescriptionRefill[]
  insuranceVerifications InsuranceVerification[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@map("callers")
}

// ============================================================================
// Scheduling Integrations
// ============================================================================

model SchedulingIntegration {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  provider   String   // 'timetap' | 'nexhealth' | 'google_calendar'
  apiKey     String   @map("api_key")
  locationId String?  @map("location_id")
  isActive   Boolean  @default(true) @map("is_active")
  config     Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([provider])
  @@map("scheduling_integrations")
}

model Appointment {
  id         String  @id @default(uuid())
  callId     String? @map("call_id")
  businessId String  @map("business_id")
  externalId String? @map("external_id")
  provider   String  // 'timetap' | 'nexhealth' | 'manual'

  callerName  String  @map("caller_name")
  callerPhone String  @map("caller_phone")
  callerEmail String? @map("caller_email")

  providerName String? @map("provider_name")
  serviceType  String? @map("service_type")

  scheduledAt DateTime          @map("scheduled_at")
  duration    Int
  status      AppointmentStatus @default(SCHEDULED)

  notes        String? @db.Text
  cancelReason String? @map("cancel_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call     CallSession? @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([callId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ============================================================================
// Call Sessions, Transcripts & Turns
// ============================================================================

model CallSession {
  id               String            @id @default(uuid())
  businessId       String            @map("business_id")
  phoneNumberId    String            @map("phone_number_id")
  twilioCallSid    String            @unique @map("twilio_call_sid")
  direction        CallDirection
  status           CallStatus        @default(INITIATED)
  recordingConsent RecordingConsent? @map("recording_consent")
  tag              CallTag?
  callerId         String?           @map("caller_id")
  isEmergency      Boolean           @default(false) @map("is_emergency")
  /** Number of problem-resolution turns completed */
  turnCount        Int               @default(0) @map("turn_count")
  /** JSON array of CallTurn objects */
  turnsJson        Json?             @map("turns_json")
  startedAt        DateTime          @default(now()) @map("started_at")
  endedAt          DateTime?         @map("ended_at")
  sentimentScore   Decimal?          @map("sentiment_score") @db.Decimal(3, 2)
  recordingUrl     String?           @map("recording_url")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumber        PhoneNumber          @relation(fields: [phoneNumberId], references: [id])
  caller             Caller?              @relation(fields: [callerId], references: [id], onDelete: SetNull)
  transcriptSegments TranscriptSegment[]
  callEvents         CallEvent[]
  projection         CallSessionProjection?
  handoffs           Handoff[]
  appointments       Appointment[]
  prescriptionRefills PrescriptionRefill[]
  insuranceInquiries InsuranceInquiry[]
  voicemails         VoicemailRecord[]
  followUpTasks      FollowUpTask[]

  @@index([businessId, startedAt])
  @@index([tag])
  @@index([callerId])
  @@index([twilioCallSid])
  @@map("call_sessions")
}

model CallEvent {
  id         String   @id @default(uuid())
  callId      String   @map("call_id")
  sequence    Int
  type        String
  domain      String?
  actionName  String?  @map("action_name")
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at")

  call CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, sequence])
  @@index([callId, createdAt])
  @@index([callId, sequence])
  @@map("call_events")
}

model CallSessionProjection {
  callId               String   @id @map("call_id")
  lastSequenceApplied  Int      @default(0) @map("last_sequence_applied")
  latestDomain         String?  @map("latest_domain")
  resolution           String?
  resolutionLabel      String?  @map("resolution_label")
  operatorNextStep     String?  @map("operator_next_step")
  latestRuntimeAction  String?  @map("latest_runtime_action")
  handledLive          Boolean? @map("handled_live")
  fallbackReason       String?  @map("fallback_reason")
  transportSummaryJson Json?    @map("transport_summary_json")
  intentTimelineJson   Json?    @map("intent_timeline_json")
  operatorSummaryJson  Json?    @map("operator_summary_json")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  call CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@map("call_session_projections")
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIATED
  ONGOING
  COMPLETED
  ABANDONED
  FAILED
}

enum RecordingConsent {
  IMPLICIT
  EXPLICIT
  DECLINED
}

enum CallTag {
  SCHEDULING
  BILLING
  INSURANCE
  FAQ
  PRESCRIPTION_REFILL
  HUMAN_TRANSFER
  EMERGENCY
  VOICEMAIL
}

model TranscriptSegment {
  id          String   @id @default(uuid())
  callId      String   @map("call_id")
  speaker     Speaker
  text        String   @db.Text
  startTimeMs Int      @map("start_time_ms")
  endTimeMs   Int      @map("end_time_ms")
  confidence  Decimal  @db.Decimal(3, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  call CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("transcript_segments")
}

enum Speaker {
  CALLER
  AGENT
  SYSTEM
}

model Handoff {
  id        String   @id @default(uuid())
  callId    String   @map("call_id")
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  call CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("handoffs")
}

/**
 * Voicemail records created when no human is available during transfer
 */
model VoicemailRecord {
  id             String   @id @default(uuid())
  callId         String   @map("call_id")
  businessId     String   @map("business_id")
  callerPhone    String   @map("caller_phone")
  callerName     String?  @map("caller_name")
  recordingUrl   String   @map("recording_url")
  transcription  String?  @db.Text
  /** Brief context about what the caller needed */
  context        String   @db.Text
  isListened     Boolean  @default(false) @map("is_listened")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  call     CallSession @relation(fields: [callId], references: [id], onDelete: Cascade)
  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  followUpTask FollowUpTask?

  @@index([businessId, isListened])
  @@index([callId])
  @@map("voicemail_records")
}

model FollowUpTask {
  id              String               @id @default(uuid())
  businessId      String               @map("business_id")
  callId          String?              @map("call_id")
  voicemailId     String?              @unique @map("voicemail_id")
  type            FollowUpTaskType
  status          FollowUpTaskStatus   @default(OPEN)
  priority        FollowUpTaskPriority @default(NORMAL)
  title           String
  summary         String               @db.Text
  callerName      String?              @map("caller_name")
  callerPhone     String?              @map("caller_phone")
  urgencyKeywords String[]             @map("urgency_keywords")
  metadata        Json?
  dueAt           DateTime?            @map("due_at")
  completedAt     DateTime?            @map("completed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call      CallSession?    @relation(fields: [callId], references: [id], onDelete: SetNull)
  voicemail VoicemailRecord? @relation(fields: [voicemailId], references: [id], onDelete: SetNull)

  @@index([businessId, status, priority])
  @@index([businessId, type, createdAt])
  @@index([callId])
  @@map("follow_up_tasks")
}

enum FollowUpTaskType {
  URGENT_CALLBACK
  VOICEMAIL_REVIEW
  MANUAL_REVIEW
  APPOINTMENT_REQUEST
  REFILL_REQUEST
  INSURANCE_CHECK
  BILLING_REQUEST
}

enum FollowUpTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FollowUpTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================================================
// Audit & Compliance
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// Billing & Usage
// ============================================================================

model StripeSubscription {
  id                   String   @id @default(uuid())
  businessId           String   @map("business_id")
  stripeSubscriptionId String   @unique @map("stripe_subscription_id")
  planKey              String   @map("plan_key")
  status               String
  currentPeriodStart   DateTime @map("current_period_start")
  currentPeriodEnd     DateTime @map("current_period_end")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("stripe_subscriptions")
}

model UsageRecord {
  id                  String   @id @default(uuid())
  businessId          String   @map("business_id")
  metric              String
  quantity            Int
  timestamp           DateTime
  stripeUsageRecordId String?  @map("stripe_usage_record_id")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, metric, timestamp])
  @@map("usage_records")
}

// ============================================================================
// Agent Catalog & Deployed Agents
// ============================================================================

/**
 * A deployed agent instance per business (copy of a catalog template)
 */
model Agent {
  id          String      @id @default(uuid())
  businessId  String      @map("business_id")
  /** References one of the 5 catalog agent IDs */
  catalogId   String      @map("catalog_id")
  name        String
  description String?     @db.Text
  status      AgentStatus @default(ACTIVE)
  /** Business-specific node graph overrides (WorkflowGraph JSON) */
  nodeGraph   Json?       @map("node_graph")
  /** Tool credentials (encrypted in app layer) */
  toolConfig  Json?       @map("tool_config")
  /** Agent-level config (greeting scripts, thresholds, etc.) */
  agentConfig Json?       @map("agent_config")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, catalogId, status])
  @@map("agents")
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

// ============================================================================
// Prescription Refills (Agent 5)
// ============================================================================

model PrescriptionRefill {
  id                 String             @id @default(uuid())
  businessId         String             @map("business_id")
  callId             String?            @map("call_id")
  callerId           String?            @map("caller_id")
  callerName         String             @map("caller_name")
  callerPhone        String             @map("caller_phone")
  callerDOB          DateTime?          @map("caller_dob") @db.Date
  medicationName     String             @map("medication_name")
  prescriberName     String?            @map("prescriber_name")
  pharmacyName       String?            @map("pharmacy_name")
  pharmacyPhone      String?            @map("pharmacy_phone")
  status             RefillStatus       @default(PENDING)
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  notes              String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call     CallSession? @relation(fields: [callId], references: [id], onDelete: SetNull)
  caller   Caller?      @relation(fields: [callerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([callId])
  @@index([status])
  @@map("prescription_refills")
}

enum RefillStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}

// ============================================================================
// Insurance Verification (Agent 3)
// ============================================================================

model InsurancePlan {
  id              String    @id @default(uuid())
  businessId      String    @map("business_id")
  planName        String    @map("plan_name")
  carrierId       String    @map("carrier_id")
  carrierName     String    @map("carrier_name")
  planType        String?   @map("plan_type")
  isAccepted      Boolean   @default(true) @map("is_accepted")
  effectiveDate   DateTime? @map("effective_date") @db.Date
  terminationDate DateTime? @map("termination_date") @db.Date
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business      Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inquiries     InsuranceInquiry[]
  verifications InsuranceVerification[]

  @@index([businessId])
  @@index([carrierId])
  @@map("insurance_plans")
}

model InsuranceInquiry {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  callId          String?  @map("call_id")
  insurancePlanId String?  @map("insurance_plan_id")
  callerName      String?  @map("caller_name")
  callerPhone     String?  @map("caller_phone")
  carrierName     String?  @map("carrier_name")
  planName        String?  @map("plan_name")
  /** 'acceptance' | 'coverage' | 'eligibility' | 'claim_status' | 'prior_auth_status' */
  inquiryType     String   @map("inquiry_type")
  resolved        Boolean  @default(false)
  outcome         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  call          CallSession?   @relation(fields: [callId], references: [id], onDelete: SetNull)
  insurancePlan InsurancePlan? @relation(fields: [insurancePlanId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([callId])
  @@map("insurance_inquiries")
}

model InsuranceVerification {
  id                    String            @id @default(uuid())
  businessId            String            @map("business_id")
  insurancePlanId       String            @map("insurance_plan_id")
  callerId              String?           @map("caller_id")
  callerName            String            @map("caller_name")
  memberNumber          String            @map("member_number")
  groupNumber           String?           @map("group_number")
  verificationDate      DateTime          @default(now()) @map("verification_date")
  eligibilityStatus     EligibilityStatus @map("eligibility_status")
  authorizationRequired Boolean           @default(false) @map("authorization_required")
  authorizationNumber   String?           @map("authorization_number")
  coverageDetails       Json?             @map("coverage_details")
  copay                 Decimal?          @db.Decimal(10, 2)
  deductible            Decimal?          @db.Decimal(10, 2)
  deductibleMet         Decimal?          @map("deductible_met") @db.Decimal(10, 2)
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  insurancePlan InsurancePlan @relation(fields: [insurancePlanId], references: [id], onDelete: Cascade)
  caller        Caller?       @relation(fields: [callerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([insurancePlanId])
  @@index([verificationDate])
  @@map("insurance_verifications")
}

enum EligibilityStatus {
  ELIGIBLE
  NOT_ELIGIBLE
  PENDING
  EXPIRED
}
